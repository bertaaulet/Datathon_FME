# Math on the Edge: shared settings for the board scripts and the Python copilot.
# Bash sources this file, and copilot/config.py parses it. Keep it KEY=VALUE.
# Every team starts from the same pinned versions, so results are comparable.

# llama.cpp, pinned to a commit tested on the UNO Q 4 GB (November 2026)
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_REF=2cbe0ec429b849a88664e0f62388fc92a5abd699
LLAMA_CPP_DIR=~/llama.cpp

MODELS_DIR=~/models

# Small language model: Qwen3.5 0.8B, Q8_0 (835 MB)
LLM_REPO=bartowski/Qwen_Qwen3.5-0.8B-GGUF
LLM_REVISION=f36b1ea49a332ede8fe5f389bbf5b3575ef71f48
LLM_FILE=Qwen_Qwen3.5-0.8B-Q8_0.gguf
LLM_SHA256=7182e2362766bb9569209bbc24cf1a4cdfbb8ab161babdb2080c84fa62c08c2f
LLM_ALIAS=qwen3.5-0.8b
LLM_PORT=8081
# One slot with 4096 tokens: enough for a problem, its options and a few examples
LLM_CTX=4096
LLM_THREADS=4
# Optional second server that can see images (see the Explorer section of the README)
VISION_PORT=8083

# Embedding model: bge-small-en-v1.5, Q8_0 (37 MB, 384 dimensions)
EMBED_REPO=CompendiumLabs/bge-small-en-v1.5-gguf
EMBED_REVISION=d32f8c040ea3b516330eeb75b72bcc2d3a780ab7
EMBED_FILE=bge-small-en-v1.5-q8_0.gguf
EMBED_SHA256=ec38e8da142596baa913124ae50550de284b6916bf59577ef2f0cb9660c2f514
EMBED_PORT=8082
# bge-small was trained on 512 tokens; longer problem texts are cut
EMBED_CTX=512
EMBED_THREADS=4
# bge-small expects this prefix on search queries, but not on stored documents
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Official run rules
TIME_LIMIT_SECONDS=60
SEED=42
# Most common answer in M3Kang high_quality (D, 24.6%): used when a problem times out
FALLBACK_ANSWER=D

# ---------------------------------------------------------------------------
# Team settings: "Ensenya el Cangur"
# ---------------------------------------------------------------------------

# predict.py. Change one at a time, and measure each with eval.py.
# How many of the model's top tokens to read when asking for letter probabilities
LOGPROBS_TOP=256
# auto: correct the letter bias when data/letter_bias.json exists (prep/letter_bias.py). off: never
# batch: measure the bias on the input file itself (no labels) and correct at the end; with fewer
# than PREDICT_BATCH_MIN problems with five options, use data/letter_bias.json instead, if any
PREDICT_DEBIAS=auto
PREDICT_BATCH_MIN=20
# No letter's bias goes below this (shares of 1). A letter the server didn't list gets a tiny
# probability, and dividing by a tiny bias would make that letter win everywhere
BIAS_FLOOR=0.05
# Retrieval (RAG): K similar TRAINING problems shown as examples, also in the official run
# (predict.py has no --rag there). 0 = off. Skipped when the index is missing.
PREDICT_RAG_K=0
PREDICT_RAG_INDEX=data/index.db
# answer: question + right value (no options, no letter). letter: the organizers' format
PREDICT_RAG_FORMAT=answer
# A retrieved problem this similar is taken as the same problem and never shown
RAG_MAX_SIM=0.97
# Extra passes with the options rotated, 0 to 4. Each one costs reading time.
PREDICT_ROTATIONS=0
# A problem with no readable options: prior = the most common letter, model = ask the model anyway
PREDICT_NO_OPTIONS=prior
# The model writes an expression and Python computes it, for problems with numeric options.
# One more model call (~12 s on the board). on or off. Mode override: a matching option wins;
# vote: its probability is multiplied by PREDICT_EXPR_WEIGHT and combined with the letter call
PREDICT_EXPRESSION=off
PREDICT_EXPR_MODE=override
PREDICT_EXPR_WEIGHT=4
# Board speed, measured in step 8 (tokens per second), to plan each call before making it.
# A problem too long to read in time is shortened (start and end kept) instead of timing out.
READ_TOKENS_PER_S=10.8
WRITE_TOKENS_PER_S=5.8
# Conservative: real text has more characters per token, so the estimate errs on the slow side
CHARS_PER_TOKEN=3.0

# Tutor web app (app/server.py)
TUTOR_PORT=8090
TUTOR_DB=data/tutor.db
# The classroom language, and the language predict.py's model reads the problems in
TUTOR_LANG=cat
MODEL_LANG=eng
# The language the Kangaroo (tutor only) reads the problem and the student's hint in.
# Changing it means running prep/kangaroo_baseline.py --redo.
KANGAROO_LANG=cat
# A hint convinces the Kangaroo when it moves the margin by more than this.
# Replace it with the value prep/hint_experiment.py measures on your board.
HINT_TAU=1.0
HINT_MAX_CHARS=200
HINT_MAX_TRIES=3
# The model writes the hint of a problem from outside the bank (copilot/hintgen.py),
# with one similar bank problem as the example. off: method hints only.
HINTGEN=on
HINTGEN_MAX_TOKENS=48

